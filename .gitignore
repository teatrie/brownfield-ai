# Local agent overrides
CLAUDE.local.md

# Logs
*.log

# Build tools
.task/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment/Secrets
.env
.env.*
!.env.example
.envrc

# OS
.DS_Store

# Chromadb
chroma_data
chromadb_export.txt
chroma_export.txt

# ========================================
# GitHub Copilot CLI Files
# ========================================
.copilot/
plan.md
# Exempt committed reviewer prompt templates from the global plan.md ignore.
!.claude/prompts/reviewer/plan.md
# User-facing TODO scratchpad; see planning_protocol.md §2
todo-plan.md
worktrees/
repos/*/

# ========================================
# Claude Code & AI Agent Files
# ========================================
# Ignore personal Claude configuration overrides
.claude/settings.local.json

# Ignore Claude's local conversation history and state
# (Prevents your team from downloading your personal chat logs)
.claude/history/
.claude/state/
.claude/messages/
.claude/projects/

# Dashboard build outputs (generated by Vite during Docker build)
services/dashboard/static/assets/
services/dashboard/static/index.html

# Node / dashboard frontend
node_modules/
# Guard against stray lockfiles elsewhere in the tree, while keeping the one
# intended lockfile tracked: the dashboard frontend is an application, not a
# library, and `npm ci` (used by the dashboard build/lint/test tasks and by
# docker/dashboard/Dockerfile) requires a committed lockfile to install.
package-lock.json
!services/dashboard/frontend/package-lock.json

# AI TDD lockfiles
.tdd-active

# MCP server logs (chroma-mcp-server etc.)
logs/
uv.lock
tmp/
agent-review/
.vscode/
*.bak

# Common AI Orchestrator / Subagent log outputs
*_output.txt
*out.txt
checks*.txt
lint*.txt
tests*.txt
*pytest*.txt
eval*.txt
format.txt
junit*.xml
